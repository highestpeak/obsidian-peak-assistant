{
  "contractVersion": "1.0.0",
  "contractId": "peak.vault-ai-batch-generation",
  "title": "Peak Assistant Vault AI Batch Generation Contract",
  "status": "design-only",
  "purpose": "定义外部 Codex 或其他受控模型客户端批量生成 Peak Assistant 可验证 AI 衍生数据时的任务范围、输入快照、输出分区与安全边界。",
  "implementationState": {
    "externalRunnerOwnsExecution": true,
    "peakExternalImporterAvailable": false,
    "directPeakIngestionAllowed": false,
    "reason": "Peak 当前没有实现该外部结果包的导入器。结果只能进入独立 staging 目录，待后续导入器完成 schema、来源哈希、provenance 与状态校验后再映射到 canonical JSON/JSONL。"
  },
  "goals": [
    "让外部客户端可以按文件、资源、社区、Hub、图谱与整个 Vault 六种范围批量运行 AI 任务。",
    "让每一条结果都能追溯到不可歧义的来源路径、SHA-256、模型、提示模板与运行 ID。",
    "允许断点续跑、失败隔离、来源变更失效与按记录重试。",
    "使结果结构能表达 Peak 当前已有能力，同时不假装外部导入链已经存在。"
  ],
  "nonGoals": [
    "本合约不生成任何摘要、标签、评语、社区、Hub、图谱或其他知识内容。",
    "本合约不修改 Vault 源文件、frontmatter、Markdown、Canvas 或 Excalidraw。",
    "本合约不直接写入 Peak canonical DataStore、SQLite、FTS、向量索引或缓存。",
    "本合约不让模型重算本地确定性图算法、哈希、分块、索引或 lint 事实。"
  ],
  "safetyBoundary": {
    "sourceVaultMode": "read-only",
    "outputMode": "staging-json-jsonl-only",
    "allowedPersistentCarriers": [
      "json",
      "jsonl"
    ],
    "forbiddenWrites": [
      "vault-source-files",
      "frontmatter",
      "markdown-materializations",
      "peak-canonical-datastore",
      "sqlite",
      "fts",
      "vector-index",
      "cache",
      "telemetry"
    ],
    "applyPolicy": "proposal-only-until-validated-importer-and-explicit-owner-approval",
    "stalePolicy": "若来源 SHA-256 与任务开始时的快照不一致，结果必须标记 stale，禁止应用。",
    "sensitivePolicy": "用户画像提案默认关闭；只有用户明确选择来源文件后才允许运行。"
  },
  "sourceSnapshotContract": {
    "hashAlgorithm": "sha256",
    "inventoryRequiredBeforeGeneration": true,
    "requiredFileFields": [
      "path",
      "sha256",
      "sizeBytes",
      "modifiedAt",
      "fileType"
    ],
    "contentTransport": "模型运行器可以读取源内容，但结果文件不得复制完整源文；仅允许必要的短 evidence excerpt。",
    "pathRules": {
      "format": "vault-relative-posix",
      "caseSensitive": true,
      "allowParentTraversal": false
    }
  },
  "scopes": [
    {
      "scope": "document",
      "unit": "一个可抽取文本的 Vault 文档",
      "partitionKey": "sha256(vaultRelativePath)"
    },
    {
      "scope": "resource",
      "unit": "一个 PDF、Office、HTML、文本或其他 Peak loader 支持的资源",
      "partitionKey": "sha256(vaultRelativePath)"
    },
    {
      "scope": "community",
      "unit": "一个由本地图算法预先计算的 community evidence snapshot",
      "partitionKey": "communityId"
    },
    {
      "scope": "hub",
      "unit": "一个 Hub 候选或已存在 Hub 的确定性 evidence snapshot",
      "partitionKey": "hubId"
    },
    {
      "scope": "graph",
      "unit": "一个带来源哈希和 evidence refs 的图谱输入快照",
      "partitionKey": "graphId/versionId"
    },
    {
      "scope": "vault",
      "unit": "一个固定来源清单与确定性统计快照代表的整个 Vault",
      "partitionKey": "vault"
    }
  ],
  "outputLayout": {
    "layoutVersion": "1.0.0",
    "root": "<user-selected-staging-directory>/<runId>",
    "files": {
      "manifest": "manifest.json",
      "sourceInventory": "source-inventory.jsonl",
      "documentResults": "documents/<path-sha256>.json",
      "resourceResults": "resources/<path-sha256>.json",
      "communityResults": "communities/<community-id>.json",
      "hubResults": "hubs/<hub-id>.json",
      "graphResults": "graphs/<graph-id>/<version-id>.json",
      "vaultResult": "vault/vault-result.json",
      "events": "events.jsonl"
    },
    "globalJsonlPolicy": "禁止把整库全部结果塞入一个全局 JSONL；JSONL 只用于来源清单和审计事件。",
    "writePolicy": "先写临时文件，完成 JSON Schema 校验后原子替换对应分区文件。",
    "resumeKey": "idempotencyKey"
  },
  "executionProfiles": [
    {
      "profileId": "recommended-safe",
      "default": true,
      "description": "不改源文件、无需社区或图谱先决快照的高吞吐逐文件任务。",
      "capabilities": [
        "document.summary.short.v1",
        "document.summary.full.v1",
        "document.tags-and-role.v1",
        "document.review-remarks.v1",
        "document.auto-review-proposals.v1",
        "document.concepts.v1",
        "document.correction-proposals.v1",
        "resource.summary.v1"
      ]
    },
    {
      "profileId": "maximal-safe",
      "default": false,
      "description": "在确定性图、community、Hub 与 Vault 快照均已准备好时运行所有非敏感、非实验能力。",
      "capabilities": [
        "document.summary.short.v1",
        "document.summary.full.v1",
        "document.tags-and-role.v1",
        "document.review-remarks.v1",
        "document.auto-review-proposals.v1",
        "document.link-proposals.v1",
        "document.frontmatter-proposals.v1",
        "document.concepts.v1",
        "document.split-proposal.v1",
        "document.correction-proposals.v1",
        "graph.node-explanation.v1",
        "resource.summary.v1",
        "community.explanation.v1",
        "vault.knowledge-intuition.v1",
        "vault.review-proposals.v1",
        "vault.activity-summary.v1",
        "vault.hub-curation-plan.v1",
        "hub.draft-and-critique.v1",
        "graph.ai-version.v1"
      ]
    },
    {
      "profileId": "sensitive-opt-in",
      "default": false,
      "description": "只在用户显式选择来源文件时生成用户画像候选事实。",
      "capabilities": [
        "vault.user-profile-proposals.v1"
      ]
    },
    {
      "profileId": "experimental-off",
      "default": false,
      "description": "当前实现或证据链不完整，不得在普通批处理里自动启用。",
      "capabilities": [
        "resource.image-description.v1",
        "vault.semantic-review-proposals.v1"
      ]
    }
  ],
