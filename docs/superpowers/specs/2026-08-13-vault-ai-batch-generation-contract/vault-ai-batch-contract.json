  "deterministicExclusions": [
    {
      "fact": "community membership and Louvain clustering",
      "owner": "local deterministic graph runtime"
    },
    {
      "fact": "PageRank, semantic PageRank and betweenness",
      "owner": "local deterministic graph runtime"
    },
    {
      "fact": "file SHA-256, source fingerprint, revision and inventory",
      "owner": "batch runner filesystem scan"
    },
    {
      "fact": "text chunks, FTS rows, TextRank terms and sentences",
      "owner": "local index runtime"
    },
    {
      "fact": "embeddings and vector indexes",
      "owner": "local embedding and index runtime"
    },
    {
      "fact": "SQLite projections, caches and telemetry",
      "owner": "Peak local rebuildable projections"
    },
    {
      "fact": "deterministic lint findings",
      "owner": "Vault Lint runtime"
    }
  ],
  "validationGate": {
    "schema": "vault-ai-batch-result.schema.json",
    "requiredBeforeAcceptingARecord": [
      "JSON parses",
      "JSON Schema validates",
      "capability was enabled by manifest",
      "source path exists in frozen inventory",
      "source SHA-256 still matches",
      "provenance and idempotencyKey are present",
      "all referenced paths exist in frozen inventory",
      "status is success, failed, skipped or stale"
    ],
    "requiredBeforeFuturePeakImport": [
      "external importer is implemented",
      "target-specific domain validation passes",
      "proposal-only fields receive explicit review",
      "canonical writer uses registered artifact IDs",
      "SQLite and indexes are rebuilt from canonical facts rather than written directly"
    ]
  }
}
